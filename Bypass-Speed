-- ============================================
-- ฟังก์ชันล็อก Speed รัวๆ
-- ============================================
local function startSpeedLock(speed)
	targetSpeed = speed
	isLocking = true

	if lockConnection then
		lockConnection:Disconnect()
	end

	local conn1 = RunService.RenderStepped:Connect(function()
		if not isLocking then return end
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.WalkSpeed ~= targetSpeed then
				hum.WalkSpeed = targetSpeed
			end
		end
	end)

	local conn2 = RunService.Heartbeat:Connect(function()
		if not isLocking then return end
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.WalkSpeed ~= targetSpeed then
				hum.WalkSpeed = targetSpeed
			end
		end
	end)

	lockConnection = {
		Disconnect = function()
			conn1:Disconnect()
			conn2:Disconnect()
		end
	}
end

-- ============================================
-- Event ปุ่มตกลง
-- ============================================
local isShowingFeedback = false

okButton.MouseButton1Click:Connect(function()
	if isShowingFeedback then return end   -- กัน spam ตอนแสดง feedback

	local input = tonumber(textBox.Text)

	if not input then
		-- ใส่ผิด → แดงเหมือนเดิม แค่เปลี่ยนข้อความ
		isShowingFeedback = true
		local oldText = okButton.Text
		okButton.Text = "❌ ใส่ตัวเลข!"
		task.wait(1)
		okButton.Text = oldText
		isShowingFeedback = false
		return
	end

	startSpeedLock(input)

	local focused = UserInputService:GetFocusedTextBox()
	if focused then focused:ReleaseFocus() end

	-- ✅ สำเร็จ → เปลี่ยนเป็นสีเขียว
	isShowingFeedback = true
	local oldText = okButton.Text

	okButton.BackgroundColor3 = GREEN_BTN
	okButton.Text = "🔥 ล็อกที่ " .. tostring(input)

	task.wait(1)

	-- กลับเป็นสีแดงเหมือนเดิม
	okButton.BackgroundColor3 = RED_BTN
	okButton.Text = oldText
	isShowingFeedback = false
end)

textBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		okButton.MouseButton1Click()
	end
end)

-- ============================================
-- Lock ต่อหลัง respawn
-- ============================================
player.CharacterAdded:Connect(function()
	if isLocking then
		task.wait(1)
		startSpeedLock(targetSpeed)
	end
end)
