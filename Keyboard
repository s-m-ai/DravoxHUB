-- RGBHandler (Sliding Orange-Red Gradient across strokes)
local function C_e7()
	local script = G2L["e7"];
	pcall(function()
		local RunService = game:GetService("RunService")
		local bool = true

		-- ===== สีที่ใช้ไล่ =====
		local RED       = Color3.fromRGB(255, 0, 0)
		local ORANGERED = Color3.fromRGB(255, 90, 0)
		local BRIGHT    = Color3.fromRGB(255, 150, 60)

		-- ===== ColorSequence 5 จุด =====
		local COLOR_SEQ = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, RED),
			ColorSequenceKeypoint.new(0.25, ORANGERED),
			ColorSequenceKeypoint.new(0.50, BRIGHT),
			ColorSequenceKeypoint.new(0.75, ORANGERED),
			ColorSequenceKeypoint.new(1.00, RED),
		})
		local WHITE_SEQ = ColorSequence.new(Color3.fromRGB(255, 255, 255))

		-- ===== ติดตั้ง UIGradient ให้ UIStroke =====
		local function setupGradient(stroke)
			local grad = stroke:FindFirstChildOfClass("UIGradient")
			if not grad then
				grad = Instance.new("UIGradient")
				grad.Color = COLOR_SEQ
				grad.Parent = stroke
			end
			return grad
		end

		-- ===== เก็บ gradient ทุกปุ่ม =====
		local gradients = {}
		local function collect()
			table.clear(gradients)
			for _, v in pairs(script.Parent:GetChildren()) do
				if v:IsA("TextButton") and v:FindFirstChildOfClass("UIStroke") then
					table.insert(gradients, setupGradient(v.UIStroke))
				end
			end
		end
		collect()
		script.Parent.ChildAdded:Connect(function(c)
			task.wait(0.1)
			if c:IsA("TextButton") and c:FindFirstChildOfClass("UIStroke") then
				table.insert(gradients, setupGradient(c.UIStroke))
			end
		end)

		-- ===== Main + FloatingIcon gradient =====
		local mainStroke = script.Parent.Parent.Parent.Main:FindFirstChildOfClass("UIStroke")
		local mainGrad = mainStroke and setupGradient(mainStroke)

		local fi = script.Parent.Parent.Parent:FindFirstChild("FloatingIcon")
		local fiStroke = fi and fi:FindFirstChildOfClass("UIStroke")
		local fiGrad = fiStroke and setupGradient(fiStroke)

		-- ===== Animate Offset (แถบส้มเลื่อนซ้าย-ขวา) =====
		local t = 0
		local speed = 0.6
		local range = 0.8

		RunService.RenderStepped:Connect(function(dt)
			if not bool then return end
			t = t + dt * speed
			local scroll = math.sin(t) * range

			for _, g in ipairs(gradients) do
				if g and g.Parent then
					g.Offset = Vector2.new(scroll, 0)
				end
			end
			if mainGrad and mainGrad.Parent then
				mainGrad.Offset = Vector2.new(scroll, 0)
			end
			if fiGrad and fiGrad.Parent then
				fiGrad.Offset = Vector2.new(scroll, 0)
			end
		end)

		-- ===== Toggle RGB =====
		script.Parent.Parent.ToggleRGB.MouseButton1Up:Connect(function()
			if bool then
				bool = false
				script.Parent.Parent.ToggleRGB.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
				for _, g in ipairs(gradients) do
					if g and g.Parent then
						g.Color = WHITE_SEQ
						g.Offset = Vector2.new(0, 0)
					end
				end
				if mainGrad and mainGrad.Parent then
					mainGrad.Color = WHITE_SEQ
					mainGrad.Offset = Vector2.new(0, 0)
				end
				if fiGrad and fiGrad.Parent then
					fiGrad.Color = WHITE_SEQ
					fiGrad.Offset = Vector2.new(0, 0)
				end
			else
				bool = true
				script.Parent.Parent.ToggleRGB.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
				for _, g in ipairs(gradients) do
					if g and g.Parent then
						g.Color = COLOR_SEQ
					end
				end
				if mainGrad and mainGrad.Parent then
					mainGrad.Color = COLOR_SEQ
				end
				if fiGrad and fiGrad.Parent then
					fiGrad.Color = COLOR_SEQ
				end
			end
		end)
	end)
end;
task.spawn(C_e7);

-- Drag
local function C_136()
	local script = G2L["136"];
	local function dragify(Frame)
		dragToggle = nil
		dragSpeed = .25
		dragInput = nil
		dragStart = nil
		dragPos = nil

		function updateInput(input)
			Delta = input.Position - dragStart
			Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + Delta.X, startPos.Y.Scale, startPos.Y.Offset + Delta.Y)
			game:GetService("TweenService"):Create(Frame, TweenInfo.new(.25), {Position = Position}):Play()
		end

		Frame.InputBegan:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				dragToggle = true
				dragStart = input.Position
				startPos = Frame.Position
				input.Changed:Connect(function()
					if (input.UserInputState == Enum.UserInputState.End) then
						dragToggle = false
					end
				end)
			end
		end)

		Frame.InputChanged:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				dragInput = input
			end
		end)

		game:GetService("UserInputService").InputChanged:Connect(function(input)
			if (input == dragInput and dragToggle) then
				updateInput(input)
			end
		end)
	end
	task.spawn(function() dragify(script.Parent.Parent.FloatingIcon) end)
	dragify(script.Parent)
end;
task.spawn(C_136);

