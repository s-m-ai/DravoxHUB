-- Helper function to create keys
local function makeKey(parent, name, text, pos, size, textSize)
	local btn = Instance.new("TextButton", parent)
	btn.TextWrapped = true
	btn.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
	btn.TextSize = textSize or 21
	btn.FontFace = Font.new([[rbxasset://fonts/families/SourceSansPro.json]], Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Size = size or UDim2.new(0, 25, 0, 25)
	btn.Name = name
	btn.Text = text
	btn.Position = pos
	local stroke = Instance.new("UIStroke", btn)
	stroke.Color = Color3.fromRGB(255, 0, 0)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local corner = Instance.new("UICorner", btn)
	corner.CornerRadius = UDim.new(0, 5)
	return btn
end

